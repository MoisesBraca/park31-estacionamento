<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_saida"
            android:textSize="28sp"
            android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/placa"
                    app:startIconDrawable="@android:drawable/ic_menu_search"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_saida_placa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_saida_buscar"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/btn_buscar"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_saida_detalhes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resumo da Estadia"
                    android:textSize="18sp"
                    android:textColor="@color/primary"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="16dp" />

                <include layout="@layout/layout_detail_row" android:id="@+id/row_placa" />
                <include layout="@layout/layout_detail_row" android:id="@+id/row_entrada" />
                <include layout="@layout/layout_detail_row" android:id="@+id/row_tempo" />
                <include layout="@layout/layout_detail_row" android:id="@+id/row_valor" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginVertical="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pagamento"
                    android:textSize="16sp"
                    android:textColor="@color/on_surface"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/rg_pagamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="20dp">

                    <RadioButton
                        android:id="@+id/rb_dinheiro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dinheiro"
                        android:checked="true"
                        android:layout_marginEnd="8dp" />

                    <RadioButton
                        android:id="@+id/rb_cartao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cartão"
                        android:layout_marginEnd="8dp" />

                    <RadioButton
                        android:id="@+id/rb_pix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pix"
                        android:layout_marginEnd="8dp" />

                    <RadioButton
                        android:id="@+id/rb_nfc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NFC (Aprox.)"
                        android:visibility="gone" />
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Valor Recebido (R$)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_saida_valor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textSize="18sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_saida_confirmar"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="20dp"
                    android:text="Finalizar e Liberar"
                    android:textSize="18sp"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/success" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
