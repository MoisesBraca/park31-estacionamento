<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Análise de Desempenho"
            android:textSize="28sp"
            android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="24dp" />

        <!-- Gráfico: Receita 7 dias -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Faturamento (Últimos 7 dias)"
            android:textSize="17sp"
            android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface"
            android:layout_marginBottom="24dp">
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/chart_receita_pro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Gráfico: Fluxo por Hora -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Picos de Movimento (Horário)"
            android:textSize="17sp"
            android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface">
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart_fluxo_pro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </LinearLayout>
</ScrollView>
