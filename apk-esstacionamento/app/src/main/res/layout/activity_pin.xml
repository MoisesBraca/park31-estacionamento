<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🅿️ Park ' 31"
        android:textSize="32sp"
        android:textColor="@color/on_surface"
        android:fontFamily="sans-serif-black" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_tagline"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="48dp" />

    <TextView
        android:id="@+id/pin_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Digite seu PIN"
        android:textSize="18sp"
        android:textColor="@color/on_surface"
        android:fontFamily="sans-serif-black" />

    <TextView
        android:id="@+id/pin_subtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:id="@+id/pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <TextView
            android:id="@+id/dot_0"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />
        <TextView
            android:id="@+id/dot_1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />
        <TextView
            android:id="@+id/dot_2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />
        <TextView
            android:id="@+id/dot_3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />
        <TextView
            android:id="@+id/dot_4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />
        <TextView
            android:id="@+id/dot_5"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />
    </LinearLayout>

    <TextView
        android:id="@+id/pin_erro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="@color/danger"
        android:visibility="gone"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/pin_lockout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="@color/warning"
        android:visibility="gone"
        android:layout_marginBottom="24dp" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4">

        <TextView
            android:id="@+id/btn_1"
            style="@style/PinButtonStyle"
            android:text="1" />
        <TextView
            android:id="@+id/btn_2"
            style="@style/PinButtonStyle"
            android:text="2" />
        <TextView
            android:id="@+id/btn_3"
            style="@style/PinButtonStyle"
            android:text="3" />
        <TextView
            android:id="@+id/btn_4"
            style="@style/PinButtonStyle"
            android:text="4" />
        <TextView
            android:id="@+id/btn_5"
            style="@style/PinButtonStyle"
            android:text="5" />
        <TextView
            android:id="@+id/btn_6"
            style="@style/PinButtonStyle"
            android:text="6" />
        <TextView
            android:id="@+id/btn_7"
            style="@style/PinButtonStyle"
            android:text="7" />
        <TextView
            android:id="@+id/btn_8"
            style="@style/PinButtonStyle"
            android:text="8" />
        <TextView
            android:id="@+id/btn_9"
            style="@style/PinButtonStyle"
            android:text="9" />
        <TextView
            android:id="@+id/pin_vazio"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="10dp" />
        <TextView
            android:id="@+id/btn_0"
            style="@style/PinButtonStyle"
            android:text="0" />
        <TextView
            android:id="@+id/btn_apagar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:gravity="center"
            android:text="⌫"
            android:textSize="28sp"
            android:textColor="@color/on_surface"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_margin="10dp" />
    </GridLayout>

</LinearLayout>
